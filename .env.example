# Resend API Key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Requires a verified sending domain in Resend; set this in Vercel Production.
# If unset, the existing onboarding@resend.dev sandbox sender remains in use.
RESEND_FROM_EMAIL=Tonguc Karacay <contact@your-verified-domain.com>

# Sanity CMS - Blog Yönetimi
# https://sanity.io/manage adresinden Project ID alın
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
