# tonguckaracay.com Growth Agent - Yapılandırma
# cp config-tc.env.example config-tc.env

# Telegram Bot Token (@BotFather'dan)
TELEGRAM_BOT_TOKEN=

# Telegram kullanıcı ID'leri (virgülle ayır, @userinfobot'tan öğren)
TELEGRAM_ALLOWED_IDS=

# Anthropic Claude API Key
ANTHROPIC_API_KEY=

# GitHub Personal Access Token (repo write yetkisi olmalı)
GITHUB_TOKEN=

# GitHub repo ve branch
GITHUB_REPO=tonguc/tonguckaracay
GITHUB_BRANCH=main

# Günlük otomatik yazı saati (UTC)
DAILY_POST_HOUR=7
DAILY_POST_MINUTE=0

# SerpAPI (SERP / PAA / ilgili aramalar)
SERPAPI_KEY=

# DataForSEO (arama hacmi — Google Ads verisi). Boşsa /fikir hacimsiz çalışır.
# app.dataforseo.com → API Access sayfasındaki login + password
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Ubersuggest (arama hacmi + SEO zorluğu — mevcut ücretli plan). DataForSEO boşsa bu kullanılır.
# Tek seferlik tarayıcı OAuth girişiyle alınan refresh token. Bot güncel token'ı
# ubersuggest_token.json'da tutar (her yenilemede değişir); bunu sadece ilk kurulumda / yeniden girişte değiştir.
UBERSUGGEST_REFRESH_TOKEN=
