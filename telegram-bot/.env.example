# Telegram Bot Token (BotFather'dan al)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Yetkili Telegram kullanıcı ID'leri (virgülle ayır)
ALLOWED_USER_IDS=123456789

# Anthropic Claude API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Sitenin bulunduğu dizin (VPS'te)
SITE_DIR=/var/www/tonguckaracay

# Git push aktif mi? (true/false)
GIT_PUSH_ENABLED=true

# GitHub remote URL (push için)
GIT_REMOTE=origin
GIT_BRANCH=main

# PM2 uygulama adı (Next.js rebuild için)
PM2_APP_NAME=tonguckaracay

# Günlük otomatik yazı saati (24h, UTC)
DAILY_POST_HOUR=7
DAILY_POST_MINUTE=0
